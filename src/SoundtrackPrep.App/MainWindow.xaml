<Window x:Class="SoundtrackPrep.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SoundtrackPrep.App"
        mc:Ignorable="d"
        Title="SoundtrackPrep"
        Height="550"
        Width="900"
        WindowStartupLocation="CenterScreen">

	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<!-- Header -->
			<RowDefinition Height="Auto"/>
			<!-- Button row -->
			<RowDefinition Height="*"/>
			<!-- Main content -->
			<RowDefinition Height="Auto"/>
			<!-- Status bar -->
		</Grid.RowDefinitions>

		<!-- Header -->
		<TextBlock Grid.Row="0"
                   Text="SoundtrackPrep"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

		<!-- Button row -->
		<Button Grid.Row="1"
				x:Name="SelectFolderButton"
				Content="Select Folder…"
				Width="160"
				Height="36"
				FontSize="14"
				FontWeight="SemiBold"
				HorizontalAlignment="Left"
				Margin="0,0,0,16"
				Click="SelectFolderButton_Click"/>

		<!-- Main content area -->
		<Border Grid.Row="2"
                Background="#F5F5F5"
                BorderBrush="#DDD"
                BorderThickness="1"
                CornerRadius="4">
			<TextBlock Text="Main content will go here"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#888"/>
		</Border>

		<!-- Status bar -->
		<TextBlock x:Name="StatusText"
				   Grid.Row="3"
				   Text="Ready"
				   Margin="0,12,0,0"
				   FontSize="14"
				   FontWeight="SemiBold"
				   Foreground="#222"/>
	</Grid>
</Window>