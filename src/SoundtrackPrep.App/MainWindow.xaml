<Window x:Class="SoundtrackPrep.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SoundtrackPrep.App"
        mc:Ignorable="d"
        Title="SoundtrackPrep"
        Height="640"
        Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16">

        <!-- Row layout:
             0 = Header
             1 = Buttons + editing tools
             2 = Track list
             3 = Status bar -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== HEADER ==================== -->
        <TextBlock Grid.Row="0"
                   Text="SoundtrackPrep"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <!-- ==================== BUTTONS + TOOLS ==================== -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">

            <!-- Main action buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="SelectFolderButton"
                        Content="Select Folder…"
                        Width="150" Height="34"
                        FontSize="13" FontWeight="SemiBold"
                        Margin="0,0,10,0"
                        Click="SelectFolderButton_Click"/>

                <Button Content="Select All"
                        Width="90" Height="34" FontSize="13"
                        Margin="0,0,8,0"
                        Click="SelectAllButton_Click"/>

                <Button Content="Select None"
                        Width="100" Height="34" FontSize="13"
                        Margin="0,0,8,0"
                        Click="SelectNoneButton_Click"/>

                <Button Content="Flatten to Single Disc"
                        Width="170" Height="34" FontSize="13"
                        Click="FlattenToSingleDisc_Click"/>
            </StackPanel>

            <!-- Tag editing fields + single Apply button -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Disc:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="13"/>
                <TextBox x:Name="DiscNumberTextBox"
                         Width="42" Height="28" FontSize="13"
                         VerticalContentAlignment="Center"
                         Text="1" Margin="0,0,12,0"/>

                <TextBlock Text="Track:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="13"/>
                <TextBox x:Name="TrackNumberTextBox"
                         Width="42" Height="28" FontSize="13"
                         VerticalContentAlignment="Center"
                         Text="1" Margin="0,0,12,0"/>

                <TextBlock Text="Title:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="13"/>
                <TextBox x:Name="TitleTextBox"
                         Width="200" Height="28" FontSize="13"
                         VerticalContentAlignment="Center"
                         Margin="0,0,12,0"/>

                <TextBlock Text="Album Artist:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="13"/>
                <TextBox x:Name="AlbumArtistTextBox"
                         Width="160" Height="28" FontSize="13"
                         VerticalContentAlignment="Center"
                         Margin="0,0,12,0"/>

                <Button Content="Apply"
                        Height="28" FontSize="13" FontWeight="SemiBold"
                        Padding="14,0"
                        Click="Apply_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- ==================== TRACK LIST ==================== -->
        <ListView x:Name="FileList"
                  Grid.Row="2"
                  BorderBrush="#CCCCCC"
                  BorderThickness="1"
                  FontSize="13"
                  SelectionChanged="FileList_SelectionChanged">

            <ListView.View>
                <GridView>
                    <!-- Checkbox column -->
                    <GridViewColumn Width="36">
                        <GridViewColumn.Header>
                            <CheckBox x:Name="HeaderCheckBox"
                                      HorizontalAlignment="Center"
                                      Click="HeaderCheckBox_Click"/>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          HorizontalAlignment="Center"
                                          Click="RowCheckBox_Click"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Disc -->
                    <GridViewColumn Width="55">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="Disc" Click="Sort_Click" Tag="Disc"/>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Disc}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Track -->
                    <GridViewColumn Width="60">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="Track" Click="Sort_Click" Tag="Track"/>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Track}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Title -->
                    <GridViewColumn Width="380">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="Title" Click="Sort_Click" Tag="Title"/>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Duration -->
                    <GridViewColumn Width="80">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="Duration" Click="Sort_Click" Tag="Duration"/>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Duration}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- ==================== STATUS BAR ==================== -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Text="Ready"
                   Margin="0,12,0,0"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="#333333"/>
    </Grid>
</Window>