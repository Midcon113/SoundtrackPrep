<Window x:Class="SoundtrackPrep.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SoundtrackPrep.App"
        mc:Ignorable="d"
        Title="SoundtrackPrep"
        Height="700"
        Width="1280"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== HEADER ==================== -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   Text="SoundtrackPrep"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <!-- ==================== LEFT SIDE: BUTTONS + TOOLS + LIST ==================== -->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,16">

            <!-- Main action buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="SelectFolderButton"
                        Content="Select Folder…"
                        Width="150" Height="34"
                        FontSize="13" FontWeight="SemiBold"
                        Margin="0,0,10,0"
                        Click="SelectFolderButton_Click"/>

                <Button Content="Select All"
                        Width="90" Height="34" FontSize="13"
                        Margin="0,0,8,0"
                        Click="SelectAllButton_Click"/>

                <Button Content="Select None"
                        Width="100" Height="34" FontSize="13"
                        Margin="0,0,8,0"
                        Click="SelectNoneButton_Click"/>

                <Button Content="Flatten to Single Disc"
                        Width="170" Height="34" FontSize="13"
                        Click="FlattenToSingleDisc_Click"/>
            </StackPanel>

            <!-- Tag editing fields -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Disc:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="13"/>
                <TextBox x:Name="DiscNumberTextBox" Width="42" Height="28" FontSize="13"
                         VerticalContentAlignment="Center" Text="1" Margin="0,0,10,0"/>

                <TextBlock Text="Track:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="13"/>
                <TextBox x:Name="TrackNumberTextBox" Width="42" Height="28" FontSize="13"
                         VerticalContentAlignment="Center" Text="1" Margin="0,0,10,0"/>

                <TextBlock Text="Title:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="13"/>
                <TextBox x:Name="TitleTextBox" Width="180" Height="28" FontSize="13"
                         VerticalContentAlignment="Center" Margin="0,0,10,0"/>

                <TextBlock Text="Album Artist:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="13"/>
                <TextBox x:Name="AlbumArtistTextBox" Width="150" Height="28" FontSize="13"
                         VerticalContentAlignment="Center" Margin="0,0,10,0"/>

                <Button Content="Apply" Height="28" FontSize="13" FontWeight="SemiBold"
                        Padding="12,0" Click="Apply_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- ==================== TRACK LIST ==================== -->
        <ListView x:Name="FileList"
                  Grid.Row="2" Grid.Column="0"
                  Margin="0,0,16,0"
                  BorderBrush="#CCCCCC"
                  BorderThickness="1"
                  FontSize="13"
                  SelectionChanged="FileList_SelectionChanged">

            <ListView.View>
                <GridView>
                    <GridViewColumn Width="36">
                        <GridViewColumn.Header>
                            <CheckBox x:Name="HeaderCheckBox" HorizontalAlignment="Center" Click="HeaderCheckBox_Click"/>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          HorizontalAlignment="Center" Click="RowCheckBox_Click"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Width="55">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="Disc" Click="Sort_Click" Tag="Disc"/>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Disc}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Width="60">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="Track" Click="Sort_Click" Tag="Track"/>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Track}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Width="360">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="Title" Click="Sort_Click" Tag="Title"/>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Width="80">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="Duration" Click="Sort_Click" Tag="Duration"/>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Duration}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- ==================== RIGHT SIDE: COVER ART ==================== -->
        <Border Grid.Row="1" Grid.Column="1" Grid.RowSpan="2"
                BorderBrush="#CCCCCC" BorderThickness="1"
                Background="#FAFAFA" Padding="12">

            <StackPanel>
                <TextBlock Text="Cover Art" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <!-- Preview -->
                <Border Width="220" Height="220"
                        BorderBrush="#AAAAAA" BorderThickness="1"
                        Background="#FFFFFF" Margin="0,0,0,12">
                    <Image x:Name="CoverArtPreview"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Border>

                <!-- Buttons -->
                <Button Content="Choose Image…"
                        Height="32" FontSize="13"
                        Margin="0,0,0,8"
                        Click="ChooseCoverArt_Click"/>

                <Button Content="Search Online…"
                        Height="32" FontSize="13"
                        Click="SearchCoverArt_Click"/>
            </StackPanel>
        </Border>

        <!-- ==================== STATUS BAR ==================== -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="3" Grid.ColumnSpan="2"
                   Text="Ready"
                   Margin="0,12,0,0"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="#333333"/>
    </Grid>
</Window>