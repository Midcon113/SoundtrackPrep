<Window x:Class="SoundtrackPrep.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SoundtrackPrep.App"
        mc:Ignorable="d"
        Title="SoundtrackPrep"
        Height="550"
        Width="950"
        WindowStartupLocation="CenterScreen">

	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Header -->
		<TextBlock Grid.Row="0"
                   Text="SoundtrackPrep"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

		<!-- Button row -->
		<Button Grid.Row="1"
                x:Name="SelectFolderButton"
                Content="Select Folder…"
                Width="160"
                Height="36"
                FontSize="14"
                FontWeight="SemiBold"
                HorizontalAlignment="Left"
                Margin="0,0,0,16"
                Click="SelectFolderButton_Click"/>

		<!-- File list as ListView with columns -->
		<ListView x:Name="FileList"
				  Grid.Row="2"
				  BorderBrush="#DDD"
				  BorderThickness="1"
				  FontSize="13">
			<ListView.View>
				<GridView>
					<!-- Checkbox column -->
					<GridViewColumn Width="40">
						<GridViewColumn.Header>
							<CheckBox x:Name="HeaderCheckBox"
									  HorizontalAlignment="Center"
									  Click="HeaderCheckBox_Click"/>
						</GridViewColumn.Header>
						<GridViewColumn.CellTemplate>
							<DataTemplate>
								<CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
										  HorizontalAlignment="Center"
										  Click="RowCheckBox_Click"/>
							</DataTemplate>
						</GridViewColumn.CellTemplate>
					</GridViewColumn>

					<GridViewColumn Header="Disc"     Width="60"  DisplayMemberBinding="{Binding Disc}"/>
					<GridViewColumn Header="Track"    Width="70"  DisplayMemberBinding="{Binding Track}"/>
					<GridViewColumn Header="Title"    Width="480" DisplayMemberBinding="{Binding Title}"/>
					<GridViewColumn Header="Duration" Width="90"  DisplayMemberBinding="{Binding Duration}"/>
				</GridView>
			</ListView.View>
		</ListView>

		<!-- Status bar -->
		<TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Text="Ready"
                   Margin="0,12,0,0"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#222"/>
	</Grid>
</Window>